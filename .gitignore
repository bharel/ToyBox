# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Companion virtual environment and Python bytecode
/companion/.venv/
__pycache__/
*.pyc

# Public examples are safe to version; actual local settings stay private.
!.env.example
!.dev.vars.example
/companion/site.local.json
/companion/site.local.*

# Game saves, browser sessions, local databases and private exports
**/WTF/
**/SavedVariables/
**/SavedVariablesPerCharacter/
**/ToyboxExport.lua.bak
**/cookies.txt
**/cookies.json
**/storage-state*.json
**/storageState*.json
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.key
*.p12
*.pfx
