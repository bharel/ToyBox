[
  {
    "name": "all needs every prerequisite",
    "rule": {
      "all": [
        {
          "kind": "questTurnedIn",
          "questId": 1
        },
        {
          "kind": "questTurnedIn",
          "questId": 2
        }
      ]
    },
    "state": {
      "flags": {
        "1": {
          "value": true,
          "at": 1000000
        },
        "2": {
          "value": false,
          "at": 1000000
        }
      }
    },
    "expected": false
  },
  {
    "name": "alternative starter is sufficient",
    "rule": {
      "any": [
        {
          "kind": "questTurnedIn",
          "questId": 41368
        },
        {
          "kind": "questTurnedIn",
          "questId": 41411
        }
      ]
    },
    "state": {
      "flags": {
        "41411": {
          "value": true,
          "at": 1000000
        }
      }
    },
    "expected": true
  },
  {
    "name": "account achievement is not character access",
    "rule": {
      "kind": "achievement",
      "achievementId": 42,
      "scope": "character"
    },
    "state": {
      "achievements": {
        "42": {
          "completed": true,
          "at": 1000000
        }
      }
    },
    "expected": null
  },
  {
    "name": "account reward achievement",
    "rule": {
      "kind": "achievement",
      "achievementId": 42,
      "scope": "account"
    },
    "state": {
      "achievements": {
        "42": {
          "completed": true,
          "at": 1000000
        }
      }
    },
    "expected": true
  },
  {
    "name": "stale bag data stays unknown",
    "rule": {
      "kind": "itemCount",
      "itemId": 1
    },
    "state": {
      "inventory": {
        "at": 999000,
        "data": {
          "1": 1
        }
      }
    },
    "expected": null
  },
  {
    "name": "weekly lifetime flag not dated",
    "rule": {
      "kind": "questTurnedIn",
      "questId": 1,
      "cadence": "weekly"
    },
    "state": {
      "flags": {
        "1": {
          "value": true,
          "at": 1000000,
          "source": "history"
        }
      },
      "weeklyResetAt": 1000100
    },
    "expected": null
  },
  {
    "name": "weekly current flag explicitly allowed",
    "rule": {
      "kind": "questTurnedIn",
      "questId": 1,
      "cadence": "weekly",
      "currentPeriodFlag": true
    },
    "state": {
      "flags": {
        "1": {
          "value": true,
          "at": 1000000,
          "source": "current-client"
        }
      },
      "weeklyResetAt": 1000100
    },
    "expected": true
  },
  {
    "name": "weekly expires offline",
    "rule": {
      "kind": "questTurnedIn",
      "questId": 1,
      "cadence": "weekly"
    },
    "state": {
      "turnIns": {
        "1": 999900
      },
      "weeklyResetAt": 999999
    },
    "expected": null
  },
  {
    "name": "archaeology window complete",
    "rule": {
      "kind": "questTurnedIn",
      "questId": 41173,
      "cadence": "fortnightly"
    },
    "state": {
      "turnIns": {
        "41173": 999900
      },
      "archaeology": {
        "id": "beacon",
        "endAt": 1000100,
        "at": 1000000
      }
    },
    "expected": true
  },
  {
    "name": "old archaeology turn-in cannot finish new window",
    "rule": {
      "kind": "questTurnedIn",
      "questId": 41173,
      "cadence": "fortnightly"
    },
    "state": {
      "turnIns": {
        "41173": 100
      },
      "archaeology": {
        "id": "beacon",
        "endAt": 2300000,
        "at": 1000000
      }
    },
    "expected": null
  },
  {
    "name": "observed chain does not require predicted calendar",
    "rule": {
      "kind": "archaeologyChain",
      "chainId": "beacon"
    },
    "state": {
      "archaeology": {
        "id": "beacon",
        "at": 1000000
      }
    },
    "expected": true
  },
  {
    "name": "changing profession invalidates recipe",
    "rule": {
      "kind": "recipeLearned",
      "spellId": 127130
    },
    "state": {
      "recipes": {
        "127130": {
          "learned": true,
          "invalidatedAt": 999999
        }
      }
    },
    "expected": null
  },
  {
    "name": "later active stage resumes chain",
    "rule": {
      "kind": "questReached",
      "questIds": [
        2,
        3
      ],
      "cadence": "once"
    },
    "state": {
      "questsAt": 1000000,
      "quests": {
        "3": {
          "complete": false
        }
      }
    },
    "expected": true
  },
  {
    "name": "weekly account completion shared across EU characters",
    "rule": {
      "kind": "questTurnedIn",
      "questId": 77236,
      "cadence": "weekly",
      "scope": "warband"
    },
    "state": {
      "weeklyResetAt": 1000100
    },
    "expected": true,
    "characters": [
      {
        "guid": "Player-2-DEF",
        "region": "EU",
        "turnIns": {
          "77236": 999990
        },
        "weeklyResetAt": 1000100
      }
    ]
  },
  {
    "name": "other region does not supply weekly evidence",
    "rule": {
      "kind": "questTurnedIn",
      "questId": 77236,
      "cadence": "weekly",
      "scope": "warband"
    },
    "state": {
      "weeklyResetAt": 1000100
    },
    "expected": null,
    "characters": [
      {
        "guid": "Player-2-DEF",
        "region": "US",
        "turnIns": {
          "77236": 999990
        },
        "weeklyResetAt": 1000100
      }
    ]
  },
  {
    "name": "equipped requirement uses actual observation",
