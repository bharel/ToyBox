  {
    "name": "wrong faction and unobserved candidates are hidden",
    "graph": {
      "version": 2,
      "contentVersion": "test",
      "routeIds": [],
      "nodes": [
        {
          "id": "a",
          "kind": "observe",
          "text": "Alliance instructions.",
          "sources": [
            "https://example.org"
          ],
          "when": {
            "kind": "faction",
            "value": "Alliance"
          },
          "manual": true
        },
        {
          "id": "h",
          "kind": "observe",
          "text": "Horde instructions.",
          "sources": [
            "https://example.org"
          ],
          "when": {
            "kind": "faction",
            "value": "Horde"
          },
          "manual": true
        },
        {
          "id": "unknown",
          "kind": "observe",
          "text": "Unobserved candidate.",
          "sources": [
            "https://example.org"
          ],
          "when": {
            "kind": "questOffered",
            "questId": 5
          },
          "hideWhenUnknown": true,
          "manual": true
        }
      ]
