":{"any":[{"any":[{"any":[{"kind":"achievement","achievementId":18368,"scope":"account"},{"kind":"questTurnedIn","questId":76249,"cadence":"once","scope":"warband"}]},{"kind":"itemCount","itemId":206355,"quantity":1}]},{"any":[{"kind":"itemCount","itemId":208096,"quantity":1},{"kind":"toyOwned","itemId":208096}]}]},"when":{"negate":{"any":[{"kind":"achievement","achievementId":18368,"scope":"account"},{"kind":"questTurnedIn","questId":76249,"cadence":"once","scope":"warband"}]}},"manual":true,"consumesItems":[{"itemId":206360,"quantity":1}],"npcId":11285,"after":["att-208096-a76815162308:collect-smokes"]},{"id":"att-208096-a76815162308:ritual","kind":"interact","text":"Keep all five candles, Eva’s Journal and Eva’s Femur. In Caer Darrow keep, turn right instead of entering the modern dungeon portal; follow the corridor to the room with a floor grate and bones. Use Eva’s Journal to perform the ritual.","sources":["https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Instances.lua","https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Zones.lua","https://www.wowhead.com/achievement=18368","https://www.wowhead.com/item=208096"],"recovery":{"text":"This room is outside the dungeon instance. Check all seven ritual items before using the journal. The ritual consumes them; the observed achievement/unlock, not Continue, establishes access."},"destination":{"mapID":22,"x":0.6979,"y":0.7186,"label":"Ritual room in Caer Darrow keep"},"completeWhen":{"any":[{"any":[{"kind":"achievement","achievementId":18368,"scope":"account"},{"kind":"questTurnedIn","questId":76249,"cadence":"once","scope":"warband"}]},{"any":[{"kind":"itemCount","itemId":208096,"quantity":1},{"kind":"toyOwned","itemId":208096}]}]},"when":{"negate":{"any":[{"kind":"achievement","achievementId":18368,"scope":"account"},{"kind":"questTurnedIn","questId":76249,"cadence":"once","scope":"warband"}]}},"manual":true,"after":["att-208096-a76815162308:trade-smokes"]},{"id":"att-208096-a76815162308:old-entry","kind":"interact","text":"Click Eva’s Enchanted Journal on the ritual pedestal and choose to enter the Memory of Scholomance. If your account already unlocked it, begin directly here.","sources":["https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Instances.lua","https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Zones.lua","https://www.wowhead.com/achievement=18368","https://www.wowhead.com/item=208096"],"recovery":{"text":"Use the book on the pedestal, not the ordinary blue dungeon portal. If it is absent, complete the ritual branch; an account achievement can support this specific account-wide unlock."},"destination":{"mapID":22,"x":0.6979,"y":0.7186,"label":"Eva’s Enchanted Journal"},"completeWhen":{"any":[{"any":[{"kind":"itemCount","itemId":208096,"quantity":1},{"kind":"toyOwned","itemId":208096}]},{"any":[{"kind":"itemCount","itemId":208096,"quantity":1},{"kind":"toyOwned","itemId":208096}]}]},"manual":true,"after":["att-208096-a76815162308:ritual"]},{"id":"att-208096-a76815162308:old-viewing-room","kind":"travel","text":"In old Scholomance, follow the dungeon corridors through the Reliquary toward the Great Ossuary. Defeat old Rattlegore below the ossuary and loot the Viewing Room Key if the Viewing Room door is locked; return upstairs and open that door.","sources":["https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Instances.lua","https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Zones.lua","https://www.wowhead.com/achievement=18368","https://www.wowhead.com/item=208096"],"recovery":{"text":"The modern and original Rattlegores are different encounters. If the door is already open, use it. Do not clear all six final study rooms merely to reach the journal."},"completeWhen":{"any":[{"any":[{"kind":"itemCount","itemId":208096,"quantity":1},{"kind":"toyOwned","itemId":208096}]},{"any":[{"kind":"itemCount","itemId":208096,"quantity":1},{"kind":"toyOwned","itemId":208096}]}]},"manual":true,"after":["att-208096-a76815162308:old-entry"],"writtenDestination":"Memory of Scholomance: follow the Reliquary corridors to the Great Ossuary. Descend into the bone pit for old Rattlegore and the key, then return upstairs to the Viewing Room door."},{"id":"att-208096-a76815162308:journal-loot","kind":"loot","text":"Inside the old Viewing Room, look behind Marduk Blackpool at the second bookcase from the left wall. Loot the small horizontal Familiar Journal from the upper shelf, partly obscured by other books.","sources":["https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Instances.lua","https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Zones.lua","https://www.wowhead.com/achievement=18368","https://www.wowhead.com/item=208096"],"recovery":{"text":"This is the original dungeon’s Familiar Journal, not Eva’s ritual journal from the modern dungeon. Circle behind the shelf and inspect carefully; receiving or using Eva’s book does not grant this toy."},"completeWhen":{"any":[{"any":[{"kind":"itemCount","itemId":208096,"quantity":1},{"kind":"toyOwned","itemId":208096}]},{"any":[{"kind":"itemCount","itemId":208096,"quantity":1},{"kind":"toyOwned","itemId":208096}]}]},"after":["att-208096-a76815162308:old-viewing-room"],"writtenDestination":"Old Scholomance Viewing Room: behind Marduk Blackpool, inspect the second bookcase from the left wall. The small horizontal journal is partly hidden on an upper shelf."},{"id":"att-208096-a76815162308:learn","kind":"learn","text":"Use Familiar Journal from your bags to learn the toy.","sources":["https://github.com/ATTWoWAddon/AllTheThings/blob/52895ee664b61e08f091d514fe1556568d411570/db/Standard/Categories/Instances.lua","https://www.wowhead.com/item=208096"],"recovery":{"text":"Only Toy Box ownership finishes this goal. Loot, mail, an achievement and the guide cursor remain separate evidence."},"completeWhen":{"kind":"toyOwned","itemId":208096},"requires":{"kind":"itemCount","itemId":208096,"quantity":1},"after":["att-208096-a76815162308:journal-loot"]}]}}