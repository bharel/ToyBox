  {
    "name": "authored text preserved with live counters",
    "graph": {
      "version": 2,
      "contentVersion": "test",
      "routeIds": [],
      "nodes": [
        {
          "id": "accept",
          "kind": "accept",
          "text": "Accept the original quest.",
          "sources": [
            "https://example.org"
          ],
          "questId": 1,
          "completeWhen": {
            "kind": "questInLog",
            "questId": 1
          }
        },
        {
          "id": "objective",
          "kind": "objective",
          "text": "Collect the three original widgets.",
          "sources": [
            "https://example.org"
          ],
          "questId": 1,
          "after": [
            "accept"
          ],
          "requires": {
            "kind": "questInLog",
            "questId": 1
          },
          "completeWhen": {
            "kind": "questObjectivesComplete",
            "questId": 1
          }
        },
        {
          "id": "turnin",
          "kind": "turnin",
          "text": "Return to the correct NPC.",
          "sources": [
            "https://example.org"
          ],
          "questId": 1,
          "after": [
            "objective"
          ],
          "requires": {
            "kind": "questObjectivesComplete",
            "questId": 1
          },
          "completeWhen": {
            "kind": "questTurnedIn",
            "questId": 1
          }
        }
      ]
    },
    "state": {
      "questsAt": 1000000,
      "quests": {
        "1": {
          "complete": false,
          "objectives": [
            {
              "text": "Widgets 2/3",
              "numFulfilled": 2,
              "numRequired": 3,
              "finished": false
            }
          ]
        }
      }
    },
    "expected": {
      "complete": false,
      "rows": [
        {
          "id": "objective",
          "text": "Collect the three original widgets.",
          "available": true,
          "counters": "Widgets 2/3"
        }
      ]
    }
  },
